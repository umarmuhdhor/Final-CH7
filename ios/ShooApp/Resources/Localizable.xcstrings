    "Protect them by double-checking what Shoo finds for the people closest to you!" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melindungi dengan mengecek kembali hasil kalkulasi Shoo milik orang terdekat anda!"
