    },
    "Applies right away. You can change it later.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Langsung berlaku. Kamu bisa mengubahnya nanti."
          }
        }
      }
    },
    "Ask your family member to scan this code, or enter the 4 digits in Shoo.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Minta anggota keluarga memindai kode ini, atau memasukkan 4 angkanya di Shoo."
          }
        }
      }
    },
    "Blocked": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diblokir"
          }
        }
      }
    },
    "Blocked scam sites will show up here.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Situs penipuan yang diblokir akan muncul di sini."
