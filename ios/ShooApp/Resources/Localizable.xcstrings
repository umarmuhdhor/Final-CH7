{
  "sourceLanguage" : "en",
  "strings" : {
    "I agree to pages being checked online." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saya setuju halaman dicek secara online."
          }
        }
      }
    },
    "See what is sent" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lihat data yang dikirim"
          }
        }
      }
    },
    "Too many changes in a minute. Wait a moment, then try again." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terlalu banyak perubahan dalam semenit. Tunggu sebentar, lalu coba lagi."
          }
        }
      }
    },
    "What is sent" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data yang dikirim"
          }
        }
      }
    },
    "When the online check is on." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat cek online menyala."
          }
        }
      }
    },
    "Page text, form field names and the address. What you type is not sent." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teks halaman, nama kolom formulir, dan alamat. Ketikanmu tidak dikirim."
          }
        }
      }
    },
    "The address and a copy are kept. Some of it stays after the account is deleted." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alamat dan salinannya disimpan. Sebagian tetap ada setelah akun dihapus."
          }
        }
      }
    },
    "A summary of a suspicious page is sent to DeepSeek, an AI from China." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ringkasan halaman mencurigakan dikirim ke DeepSeek, AI asal Tiongkok."
          }
        }
      }
    },
    "Without the online check" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanpa cek online"
          }
        }
      }
    },
    "Shoo checks on your iPhone only, with less protection." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shoo hanya cek di iPhone, perlindungan lebih terbatas."
