{
  "sourceLanguage": "en",
  "strings": {
    "%@ will be told when you open a risky site, and can check it for you.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ akan diberi tahu saat kamu membuka situs berisiko, dan bisa memeriksanya untukmu."
          }
        }
      }
    },
    "%@ will no longer see the sites Shoo warns you about.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tidak akan lagi melihat situs yang diperingatkan Shoo."
          }
        }
      }
    },
    "%@ won't be protected by you anymore. You won't see their activity.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tidak lagi kamu jaga. Kamu tidak akan melihat aktivitasnya."
          }
        }
      }
    },
    "%@, adds %lld percent to the risk score": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, menambah %lld persen ke skor risiko"
          }
        }
      }
    },
    "%lld not connected": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld tidak terhubung"
          }
        }
      }
    },
    "1 to 20 characters": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "1 sampai 20 karakter"
          }
        }
      }
    },
    "1–20 characters. Your family sees this name.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "1–20 karakter. Keluargamu melihat nama ini."
          }
        }
      }
    },
    "4-digit code": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kode 4 angka"
          }
        }
      }
    },
    "A family member looks after you.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anggota keluarga menjagamu."
          }
        }
      }
    },
    "A Guardian looks after up to 3 family members who are Protected.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu Guardian menjaga sampai 3 anggota keluarga yang Protected."
          }
        }
      }
    },
    "A warning before it's too late": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatan sebelum terlambat"
          }
        }
      }
    },
