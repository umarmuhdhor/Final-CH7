{
    "manifest_version": 3,
    "default_locale": "en",

    "name": "__MSG_extension_name__",
    "description": "__MSG_extension_description__",
    "version": "0.1.0",
    "minimum_chrome_version": "116",

    "icons": {
        "48": "images/icon-48.png",
        "96": "images/icon-96.png",
        "128": "images/icon-128.png"
    },

    "background": {
        "service_worker": "background.js",
        "type": "module"
    },

    "content_scripts": [{
        "js": [ "browser-shim.js", "dom.js", "lists-client.js", "detector.js", "pipeline.js", "pill.js", "popup.js", "marks.js", "block.js", "snapshot.js", "content.js" ],
        "matches": [ "http://*/*", "https://*/*" ],
        "run_at": "document_idle"
    }],

    "web_accessible_resources": [{
        "resources": [ "blocked.html", "blocked.css", "browser-shim.js", "block.js", "blocked-page.js", "images/icon-96.png" ],
        "matches": [ "http://*/*", "https://*/*" ]
    }],

    "permissions": [ "storage", "alarms" ],
    "host_permissions": [ "http://*/*", "https://*/*" ]
}
