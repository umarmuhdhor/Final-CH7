# Copy to ai/.env (gitignored) for local runs. In production these are Worker secrets, never committed.
# Layer 4 (LLM reality check) is OFF unless all three of the first lines are set.
# Any provider with an OpenAI-compatible POST {LLM_BASE_URL}/chat/completions works; the model is chosen after the eval (TODO A2).
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://example-provider.invalid/v1
# Optional. Timeout is capped at 6000 ms (D-imelda-39; /analyze also cuts layer 4 at 6.5 s after the request arrived). Daily cap = max provider calls per UTC day per Worker isolate.
LLM_TIMEOUT_MS=6000
LLM_DAILY_CAP=5000
# Local dev server only: per-IP limit on layer 4 calls. Unset = off (every local request is one "unknown" client).
# LLM_CLIENT_CALLS_PER_HOUR=20
