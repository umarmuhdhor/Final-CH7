        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanpa ini, Shoo hanya memeriksa halaman di ponselmu dan perlindunganmu berkurang. Halaman berisiko tetap dilaporkan. Kamu bisa mengubahnya di Profil."
          }
        }
      }
    },
