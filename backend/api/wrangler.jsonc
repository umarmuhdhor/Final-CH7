{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shoo-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Fase 22 O3: smaller bundle = less to parse at cold start. Source maps keep production stack traces
  // and the CPU flamegraph readable. Function names stay (wrangler's default esbuild keepNames), so log lines do not change.
  "minify": true,
  "upload_source_maps": true,
  // Images bundled into the Worker as ArrayBuffer (PR-03 invite link preview and page hero, src/routes/join-page.ts).
  "rules": [{ "type": "Data", "globs": ["**/*.jpg", "**/*.png"], "fallthrough": false }],
  // Our own JSON logs only: invocation logs record full request URLs, which carry
  // screenshot link ids/signatures and invite codes (SECURITY §3, D-alief-40).
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "hyperdrive": [
    {
      "binding": "DB",
      // Hyperdrive `shoo-db` (caching disabled), created in fase 07 manual step 3.
      // The id is not a secret. The cloud connection string never appears in this repo.
      "id": "f6c9b58d147c457ab5691d47d85f8309",
      // Local Supabase (supabase start). Dev-only password from db/supabase/seed.sql.
      "localConnectionString": "postgres://shoo_api:shoo_api_local@127.0.0.1:54322/postgres"
    }
  ],
  "vars": {
    // Cloud Worker URL (fase 07 manual step 4).
    "INVITE_BASE_URL": "https://shoo-api.afindo-mi01.workers.dev",
    // PR-03 invite page: TestFlight public link now, App Store later. Empty → https://apps.apple.com/.
    "APP_STORE_URL": "",
    // Universal Link (issue #129): `<Team ID>.<bundle ID>` of the builds that open /j/<code>, comma-separated.
    // Not a secret. Empty → the AASA lists no app and the link stays a web page.
    "APPLINKS_APP_IDS": "DWTZNGA7Y8.com.umarmuhdhor.shoo",
    // APNs (fase 11): bundle ID of the build that receives pushes (B6) and the APNs host.
    // Empty topic → pushes are only logged. Key, key id and team id are secrets (wrangler secret put).
    "APNS_TOPIC": "com.umarmuhdhor.shoo",
    "APNS_ENV": "production",
    // Supabase project URL, for Storage only (not a secret). The key is a secret (wrangler secret put).
    "SUPABASE_URL": "https://nmekxihgjszgcibqytyj.supabase.co",
    // contracts/api.md: screenshots over 150 KB are dropped.
    "SCREENSHOT_MAX_BYTES": "153600",
    // EX-07 kill-switch (D-alief-C25 d, not a secret): "false" stops storing and serving page
    // replicas at once. Retention and DELETE /devices/me still remove R2 objects either way.
    "REPLICAS_ENABLED": "true",
    // E7 (fase 24a, K8, not a secret): the daily retention step for devices unused for 90 days
    // (registrations never used again: 30 days). "dry_run" only counts candidates and logs the number;
    // "delete" deletes them (24a-2, after 7 clean dry runs); "off" or any other value skips the step.
    "INACTIVE_DEVICES": "dry_run"
  },
  // EX-07 page replicas and PR-05 favicons (D-alief-C23, C27): private bucket, no r2.dev, no custom
  // domain, no CORS, 17-day lifecycle rule as a safety net (fase 18 LANGKAH MANUAL 1). Tests and
  // `wrangler dev` use a local Miniflare bucket.
  // ADM-07 (dashboard plan fase 07a K5): evidence fragments and one favicon per domain for the admin
  // archive. Private, APAC, no r2.dev, no lifecycle rule (kept for good; 07a LANGKAH MANUAL 0).
  "r2_buckets": [
    { "binding": "REPLICAS", "bucket_name": "shoo-replicas" },
    { "binding": "REPLICA_ARCHIVE", "bucket_name": "shoo-replica-archive" }
  ],
  // Daily retention at 19:00 UTC = 03:00 WITA (src/cron/retention.ts, R4 §5), and hourly at :05
  // the PF-01 notifications (src/cron/notifications.ts). Kept in sync with CRONS in src/index.ts.
  "triggers": { "crons": ["0 19 * * *", "5 * * * *"] },
  // Run the Worker near the database it talks to (D-alief-B10 g: several DB round trips per
  // request). Reversible; measured in fase 12 LANGKAH MANUAL.
  "placement": { "mode": "smart" },
  // Polling and anti-scraping limits without a DB row per request (hitEdge, src/http/rateLimit.ts).
  // Same max and window as `limits` there; period can only be 10 or 60. namespace_id is unique per
  // account: shoo-ai (same account since #258) uses 1001 and 1002. Removing one → the DB counter again.
  "ratelimits": [
    { "name": "VERDICTS_GET_LIMITER", "namespace_id": "2001", "simple": { "limit": 30, "period": 10 } },
    { "name": "SCREENSHOTS_VIEW_LIMITER", "namespace_id": "2002", "simple": { "limit": 120, "period": 60 } },
    { "name": "FAVICONS_VIEW_LIMITER", "namespace_id": "2003", "simple": { "limit": 600, "period": 60 } },
    { "name": "REPLICAS_VIEW_LIMITER", "namespace_id": "2004", "simple": { "limit": 10, "period": 60 } },
    { "name": "LIVE_PUSH_LIMITER", "namespace_id": "2005", "simple": { "limit": 10, "period": 10 } }
  ]
}
