{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shoo-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Images bundled into the Worker as ArrayBuffer (PR-03 invite link preview, src/routes/join-page.ts).
  "rules": [{ "type": "Data", "globs": ["**/*.jpg"], "fallthrough": false }],
  // Our own JSON logs only: invocation logs record full request URLs, which carry
  // screenshot link ids/signatures and invite codes (SECURITY §3, D-alief-40).
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "hyperdrive": [
    {
      "binding": "DB",
      // Hyperdrive `shoo-db` (caching disabled), created in fase 07 manual step 3.
      // The id is not a secret. The cloud connection string never appears in this repo.
      "id": "f6c9b58d147c457ab5691d47d85f8309",
      // Local Supabase (supabase start). Dev-only password from db/supabase/seed.sql.
      "localConnectionString": "postgres://shoo_api:shoo_api_local@127.0.0.1:54322/postgres"
    }
  ],
  "vars": {
    // Cloud Worker URL (fase 07 manual step 4).
    "INVITE_BASE_URL": "https://shoo-api.afindo-mi01.workers.dev",
    // PR-03 invite page: TestFlight public link now, App Store later. Empty → https://apps.apple.com/.
    "APP_STORE_URL": "",
    // Universal Link (issue #129): `<Team ID>.<bundle ID>` of the builds that open /j/<code>, comma-separated.
    // Not a secret. Empty → the AASA lists no app and the link stays a web page.
    "APPLINKS_APP_IDS": "DWTZNGA7Y8.com.umarmuhdhor.shoo",
    // APNs (fase 11): bundle ID of the build that receives pushes (B6) and the APNs host.
    // Empty topic → pushes are only logged. Key, key id and team id are secrets (wrangler secret put).
    "APNS_TOPIC": "",
    "APNS_ENV": "sandbox",
    // Supabase project URL, for Storage only (not a secret). The key is a secret (wrangler secret put).
    "SUPABASE_URL": "https://nmekxihgjszgcibqytyj.supabase.co",
    // contracts/api.md: screenshots over 150 KB are dropped.
    "SCREENSHOT_MAX_BYTES": "153600"
  },
  // Daily retention at 19:00 UTC = 03:00 WITA (src/cron/retention.ts, R4 §5), and hourly at :05
  // the PF-01 notifications (src/cron/notifications.ts). Kept in sync with CRONS in src/index.ts.
  "triggers": { "crons": ["0 19 * * *", "5 * * * *"] },
  // Run the Worker near the database it talks to (D-alief-B10 g: several DB round trips per
  // request). Reversible; measured in fase 12 LANGKAH MANUAL.
  "placement": { "mode": "smart" }
}
